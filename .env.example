# Server
APP_NAME=Talib-e-Kharch
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Neon Serverless PostgreSQL)
# Get from: https://neon.tech -> Create Project -> Connection Details
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxxx.us-east-2.aws.neon.tech/talib_e_kharch?sslmode=require

# Gemini AI (Free Tier)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Uplift AI Voice
# Get from: https://upliftai.org/dashboard
UPLIFTAI_API_KEY=your-upliftai-api-key-here
UPLIFTAI_VOICE_ID=prime-time-anchor

# RevenueCat (Subscription Webhook Validation)
# Get from: https://app.revenuecat.com -> Project Settings -> API Keys
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-auth-header

# CORS (Frontend URL)
FRONTEND_URL=http://localhost:8081
